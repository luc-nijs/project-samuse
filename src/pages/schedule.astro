---
import Base from '../layouts/Base.astro';
---
<Base title="Schedule" path="/schedule">
  <section class="schedule-top">
    <div class="wrap">
      <div class="box">
        <h1>Schedule</h1>
        <p>In this page you can find the schedule of the symposium.</p>
      </div>
    </div>
  </section>
  <section class="schedule-img">
    <div class="wrap">
      <img src="/images/schedule.jpg" alt="Schedule of the Symposium" width="945" height="1381" />
    </div>
  </section>
</Base>
