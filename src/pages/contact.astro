---
import Base from '../layouts/Base.astro';
// The Wix form is replaced by one that opens the visitor's email program.
const TO = 'luc.nijs@uni.lu';
---
<Base title="Contact" path="/contact">
  <section class="contact">
    <form id="contact-form" data-to={TO}>
      <h1>Contact us</h1>
      <div class="two">
        <div><label for="first">First name *</label><input id="first" name="first" required autocomplete="given-name" /></div>
        <div><label for="last">Last name</label><input id="last" name="last" autocomplete="family-name" /></div>
      </div>
      <label for="aff">Affiliation</label><input id="aff" name="aff" autocomplete="organization" />
      <label for="email">Email *</label><input id="email" name="email" type="email" required autocomplete="email" />
      <label for="msg">Write a message</label><textarea id="msg" name="msg"></textarea>
      <button class="btn dark" type="submit">Submit</button>
    </form>
  </section>
  <script is:inline>
    document.getElementById('contact-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var f = e.target, v = function (n) { return f.elements[n].value.trim(); };
      var name = (v('first') + ' ' + v('last')).trim();
      var body = v('msg') + '\n\n' + name + (v('aff') ? '\n' + v('aff') : '') + '\n' + v('email');
      location.href = 'mailto:' + f.dataset.to + '?subject=' + encodeURIComponent('via website') + '&body=' + encodeURIComponent(body);
    });
  </script>
</Base>
